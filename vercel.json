{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feature/brand-login-website": false
    }
  },
  "functions": {
    "api/request-assistant.js": {
      "maxDuration": 25
    }
  }
}
